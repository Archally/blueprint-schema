{
  "workbench.iconTheme": "material-icon-theme",

  "yaml.schemas": {
    "schema/v2.8/blueprint.schema.yaml": ["**/.blueprint/**/blueprint.yaml"],
    "schema/v2.8/metamodel.schema.yaml": ["**/.blueprint/**/metamodel.schema.yaml"],
    "schema/v2.8/migration.schema.yaml": ["**/.blueprint/**/migration.yaml", "**/.blueprint/**/*.migration.yaml"],
    "schema/v2.8/design/arch.schema.yaml": ["**/.blueprint/**/arch.yaml", "**/.blueprint/**/*.arch.yaml"],
    "schema/v2.8/design/concepts.schema.yaml": ["**/.blueprint/**/concepts.yaml", "**/.blueprint/**/*.concepts.yaml"],
    "schema/v2.8/design/domain.schema.yaml": ["**/.blueprint/**/domain.yaml", "**/.blueprint/**/*.domain.yaml"],
    "schema/v2.8/design/dynamics.schema.yaml": ["**/.blueprint/**/dynamics.yaml", "**/.blueprint/**/*.dynamics.yaml"],
    "schema/v2.8/design/models.schema.yaml": ["**/.blueprint/**/models.yaml", "**/.blueprint/**/*.models.yaml"],
    "schema/v2.8/design/quality.schema.yaml": ["**/.blueprint/**/quality.yaml", "**/.blueprint/**/*.quality.yaml"],
    "schema/v2.8/design/infrastructure.schema.yaml": ["**/.blueprint/**/infrastructure.yaml", "**/.blueprint/**/*.infrastructure.yaml"],
    "schema/v2.8/design/rules.schema.yaml": ["**/.blueprint/**/rules.yaml", "**/.blueprint/**/*.rules.yaml"],
    "schema/v2.8/design/story.schema.yaml": ["**/.blueprint/**/story.yaml", "**/.blueprint/**/*.story.yaml"],
    "schema/v2.8/design/interactions.schema.yaml": ["**/.blueprint/**/interactions.yaml", "**/.blueprint/**/*.interactions.yaml"],
    "schema/v2.8/governance/capability.schema.yaml": ["**/.blueprint/**/capability.yaml", "**/.blueprint/**/*.capability.yaml"],
    "schema/v2.8/governance/decisions.schema.yaml": ["**/.blueprint/**/decisions.yaml", "**/.blueprint/**/*.decisions.yaml"],
    "schema/v2.8/governance/leverage.schema.yaml": ["**/.blueprint/**/leverage.yaml", "**/.blueprint/**/*.leverage.yaml"],
    "schema/v2.8/governance/motivation.schema.yaml": ["**/.blueprint/**/motivation.yaml", "**/.blueprint/**/*.motivation.yaml"],
    "schema/v2.8/governance/organization.schema.yaml": ["**/.blueprint/**/organization.yaml", "**/.blueprint/**/*.organization.yaml"],
    "schema/v2.8/governance/roadmap.schema.yaml": ["**/.blueprint/**/roadmap.yaml", "**/.blueprint/**/*.roadmap.yaml"],
    "schema/v2.8/governance/test-cases.schema.yaml": ["**/.blueprint/**/test-cases.yaml", "**/.blueprint/**/*.test-cases.yaml"],
    "schema/v2.8/governance/value-stream.schema.yaml": ["**/.blueprint/**/value-stream.yaml", "**/.blueprint/**/*.value-stream.yaml"]
  },

  // Material Icon Theme: one icon per blueprint file kind and per contract kind. Every file name the
  // model loader accepts (tools/model-builder/src/schemaTypes.ts) has an entry, as the bare name and
  // as <name>.<kind>.yaml where the loader accepts that shape. A user settings.json wins over this
  // block key by key, so keep any user-level entry for these names identical or remove it. In a
  // multi-root window VS Code reads these keys, workbench.iconTheme and yaml.schemas from the
  // .code-workspace file only; .vscode/blueprint-schema.code-workspace is a template that carries
  // them (README, "Editor setup").
  "material-icon-theme.files.associations": {
    // Blueprint layer files: the bare name, then <name>.<kind>.yaml.
    "concepts.yaml": "instructions",
    "*.concepts.yaml": "instructions",
    "rules.yaml": "conduct",
    "*.rules.yaml": "conduct",
    "domain.yaml": "shader",
    "*.domain.yaml": "shader",
    "arch.yaml": "architecture",
    "*.arch.yaml": "architecture",
    "motivation.yaml": "favicon",
    "*.motivation.yaml": "favicon",
    "decisions.yaml": "verified",
    "*.decisions.yaml": "verified",
    "test-cases.yaml": "test-js",
    "*.test-cases.yaml": "test-js",
    "dynamics.yaml": "bench-ts",
    "*.dynamics.yaml": "bench-ts",
    "quality.yaml": "todo",
    "*.quality.yaml": "todo",
    "capability.yaml": "nim",
    "*.capability.yaml": "nim",
    "story.yaml": "pipeline",
    "*.story.yaml": "pipeline",
    "models.yaml": "email",
    "*.models.yaml": "email",
    "rg.yaml": "3d",
    "*.rg.yaml": "3d",
    "infrastructure.yaml": "3d",
    "*.infrastructure.yaml": "3d",
    "org.yaml": "tree",
    "*.org.yaml": "tree",
    "organization.yaml": "tree",
    "*.organization.yaml": "tree",
    "ui.yaml": "figma",
    "*.ui.yaml": "figma",
    "interactions.yaml": "figma",
    "*.interactions.yaml": "figma",
    "roadmap.yaml": "roadmap",
    "*.roadmap.yaml": "roadmap",
    "value-stream.yaml": "tune",
    "*.value-stream.yaml": "tune",
    "leverage.yaml": "smarty",
    "*.leverage.yaml": "smarty",
    "blueprint.yaml": "toc",
    "migration.yaml": "diff",
    "*.migration.yaml": "diff",
    "migrations.yaml": "log",
    // Contract specs, by their kind-identifying extension.
    "*.openapi": "openapi",
    "*.openapi.yaml": "openapi",
    "*.asyncapi": "turborepo",
    "*.asyncapi.yaml": "turborepo",
    "*.arazzo": "url",
    "*.openrpc": "hosts",
    "*.openrpc.json": "hosts",
    "*.pact.json": "certificate"
  },

  "material-icon-theme.folders.associations": {
    ".blueprint": "sandbox"
  },
  "workbench.colorTheme": "Dark 2026"
}
