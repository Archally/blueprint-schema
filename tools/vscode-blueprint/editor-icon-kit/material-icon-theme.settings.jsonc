{
  // Opt in with Material Icon Theme installed and active. Merge entries into an existing
  // material-icon-theme.files.associations object; keep conflicting values until resolved.
  "material-icon-theme.files.associations": {
    // Blueprint layer files, in the router's order: the bare name, then <name>.<kind>.yaml.
    "concepts.yaml": "instructions",
    "*.concepts.yaml": "instructions",
    "rules.yaml": "conduct",
    "*.rules.yaml": "conduct",
    "domain.yaml": "shader",
    "*.domain.yaml": "shader",
    "arch.yaml": "architecture",
    "*.arch.yaml": "architecture",
    "motivation.yaml": "favicon",
    "*.motivation.yaml": "favicon",
    "decisions.yaml": "verified",
    "*.decisions.yaml": "verified",
    "test-cases.yaml": "test-js",
    "*.test-cases.yaml": "test-js",
    "dynamics.yaml": "bench-ts",
    "*.dynamics.yaml": "bench-ts",
    "quality.yaml": "todo",
    "*.quality.yaml": "todo",
    "capability.yaml": "nim",
    "*.capability.yaml": "nim",
    "story.yaml": "pipeline",
    "*.story.yaml": "pipeline",
    "models.yaml": "email",
    "*.models.yaml": "email",
    "rg.yaml": "3d",
    "*.rg.yaml": "3d",
    "infrastructure.yaml": "3d",
    "*.infrastructure.yaml": "3d",
    "org.yaml": "tree",
    "*.org.yaml": "tree",
    "organization.yaml": "tree",
    "*.organization.yaml": "tree",
    "ui.yaml": "figma",
    "*.ui.yaml": "figma",
    "interactions.yaml": "figma",
    "*.interactions.yaml": "figma",
    "roadmap.yaml": "roadmap",
    "*.roadmap.yaml": "roadmap",
    "value-stream.yaml": "tune",
    "*.value-stream.yaml": "tune",
    "leverage.yaml": "smarty",
    "*.leverage.yaml": "smarty",
    "blueprint.yaml": "toc",
    "migration.yaml": "diff",
    "*.migration.yaml": "diff",
    "migrations.yaml": "log",
    // Contract specs, by the kind-identifying extension the contract generator writes.
    "*.openapi": "openapi",
    "*.openapi.yaml": "openapi",
    "*.asyncapi": "turborepo",
    "*.asyncapi.yaml": "turborepo",
    "*.arazzo": "url",
    "*.openrpc": "hosts",
    "*.openrpc.json": "hosts",
    "*.pact.json": "certificate",
    // Legacy v1 DSL files (with their v2 kind's icon where one exists) and schema files.
    "*.domain": "shader",
    "*.sys": "architecture",
    "*.arch": "architecture",
    "*.infra": "3d",
    "*.rg": "3d",
    "*.story": "pipeline",
    "*.changelog": "changelog",
    "*.schema.yaml": "json_schema",
    // Manifest recipes: exact supported demo names, publication, artifact render, and film render.
    "demo.ecommerce.manifest.yaml": "packship",
    "demo.prestashop.manifest.yaml": "packship",
    "demo.eshop.manifest.yaml": "packship",
    "publication.manifest.yaml": "semantic-release",
    "render.manifest.yaml": "image",
    "render.minimal.manifest.yaml": "image",
    "film.render.manifest.yaml": "video"
  }
}
