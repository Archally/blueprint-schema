{
  "name": "@archally/blueprint-schema",
  "version": "2.7.14",
  "description": "YAML-based schema for digital system modeling — domain-first multi-method specification format",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Walkowski <adam.walkowski@inperceptic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/archally/blueprint-schema"
  },
  "homepage": "https://archally.pro",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "architecture",
    "schema",
    "yaml",
    "json-schema",
    "blueprint"
  ],
  "type": "module",
  "exports": {
    "./schema/v2.7/*": "./schema/v2.7/schema/*",
    "./model": {
      "types": "./tools/model-builder/dist/index.d.ts",
      "import": "./tools/model-builder/dist/index.js"
    }
  },
  "files": [
    "schema/",
    "tools/",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-FSL",
    "NOTICE",
    "TRADEMARKS.md",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/src/cli.mjs",
    "validate:examples": "node tools/validator/src/cli.mjs examples/ecommerce/.blueprint/v2.6 --schemas schema/v2.6",
    "build": "tsc -p tools/model-builder/tsconfig.json && tsc -p tools/semantic-checker/tsconfig.json && tsc -p tools/schema-update/tsconfig.json && tsc -p tools/renderer/tsconfig.json && tsc -p tools/schema-atlas/tsconfig.json && tsc -p tools/guide-publisher/tsconfig.json",
    "render": "node tools/renderer/dist/cli.js",
    "render:ecommerce": "node tools/renderer/dist/cli.js examples/ecommerce/.blueprint/v2.6 -o examples/ecommerce/.blueprint/v2.6/.specs/overview.md -t E-Commerce",
    "render:prestashop": "node tools/renderer/dist/cli.js examples/prestashop/.blueprint/v2.7 -o examples/prestashop/.blueprint/v2.7/.specs/overview.md -t PrestaShop-v9",
    "render:check": "node tools/renderer/dist/cli.js examples/prestashop/.blueprint/v2.7 -o examples/prestashop/.blueprint/v2.7/.specs/overview.md -t PrestaShop-v9 --check",
    "check": "node tools/semantic-checker/dist/cli.js",
    "next-id": "node tools/next-id/cli.mjs",
    "coverage-check": "node tools/coverage-check/cli.mjs",
    "entity-query": "node tools/entity-query/cli.mjs",
    "doc-snippets": "node tools/doc-snippet-validate/cli.mjs docs/modeling-guide.md docs/file-conventions.md docs/schema-reference.md --schemas schema/v2.7",
    "coverage-check:examples": "node tools/coverage-check/cli.mjs src/Core/Domain/Cart/CartStatus.php src/BrandNew/Feature.php --model examples/prestashop/.blueprint/v2.7",
    "check:examples": "node tools/semantic-checker/dist/cli.js examples/ecommerce/.blueprint/v2.6",
    "quality": "node tools/quality-gate/cli.mjs",
    "quality:examples": "node tools/quality-gate/cli.mjs examples/prestashop/.blueprint/v2.7 --strict",
    "atlas": "node tools/schema-atlas/dist/cli.js generate",
    "atlas:check": "node tools/schema-atlas/dist/cli.js check",
    "guides:build": "node tools/guide-publisher/dist/cli.js build",
    "guides:pdf": "node tools/guide-publisher/dist/cli.js pdf",
    "guides:check": "node tools/guide-publisher/dist/cli.js check",
    "test": "vitest run --config tools/model-builder/vitest.config.ts && vitest run --config tools/semantic-checker/vitest.config.ts && vitest run --config tools/renderer/vitest.config.ts && vitest run --config tools/schema-atlas/vitest.config.ts && vitest run --config tools/guide-publisher/vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "blueprint-validate": "tools/validator/src/cli.mjs",
    "blueprint-model": "tools/model-builder/dist/cli.js",
    "blueprint-check": "tools/semantic-checker/dist/cli.js",
    "blueprint-schema-update": "tools/schema-update/dist/cli.js",
    "blueprint-render": "tools/renderer/dist/cli.js",
    "blueprint-atlas": "tools/schema-atlas/dist/cli.js",
    "blueprint-guides": "tools/guide-publisher/dist/cli.js",
    "blueprint-next-id": "tools/next-id/cli.mjs",
    "blueprint-coverage-check": "tools/coverage-check/cli.mjs",
    "blueprint-entity-query": "tools/entity-query/cli.mjs"
  },
  "dependencies": {
    "@archally/semantic-checker": "github:archally/semantic-checker#v0.1.1",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "chalk": "^5.6.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^24.12.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
